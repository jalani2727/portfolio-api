{
  "include": [
    "**/*.ts",
    "eslint.config.js",
    "prettier.config.js",
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "paths": {
      "#/*": [
        "./src/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false, // TODO: Set to true when you are out of "learning mode"
    "noUnusedParameters": false, // TODO: Set to true when you are out of "learning mode"
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": false,
  }
}